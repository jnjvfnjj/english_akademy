# Backend configuration
# Replace with the managed PostgreSQL connection string in production.
DATABASE_URL=jdbc:postgresql://localhost:5432/english_school_crm
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_DRIVER=org.postgresql.Driver
DATABASE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Set only in the backend runtime. This creates the initial admin once.
ADMIN_EMAIL=admin@school.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Local development only. On Vercel, set EXPO_PUBLIC_API_URL in the project's
# Environment Variables to the public HTTPS backend URL, ending in /api.
EXPO_PUBLIC_API_URL=http://localhost:8080/api
